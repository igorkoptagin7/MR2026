void alice_salary(const int year, const int month) {
	if (year % 2 == 0 and month == 9) {
		alice.salary += 5'000; // promotion
	}
	alice.cash += alice.salary;
	alice.cash += 10'000 * alice.health; // award
	alice.mood -= 0.01;
}
void alice_deposit(const int year, const int month) {

	if (alice.cash > 0) {
		int ostatok = alice.cash * 0.3;
		if (alice.cash >= 80'000) {
			alice.cash -= ostatok;
			alice.deposit += ostatok;
		}
		else if (alice.cash < 80'000 and alice.deposit >= 20'000) { //no money, no funny
			alice.cash += 20'000;
			alice.deposit -= 20'000;
		}
	}
	else if (alice.cash < 0) {
		alice.cash = alice.deposit;
		alice.deposit = 0;
	}

	if (year != 2026 and month != 9 and alice_deposit != 0) { //no profit fist month
		alice.deposit = ((alice.deposit_rate * alice.deposit) / 12) + alice.deposit;
	}
}

void alice_car(const int year, const int month) {
	const RUB oil_cost = 7'000;
	const RUB tires_cost = 4'000;
	const RUB TI_cost = 20'000;
	const RUB insurance_cost = 15'000;
	const RUB wash_cost = 1'000;
	const RUB Metro = 1'500;

	RUB total = oil_cost;

	if (alice.car == 1) {
		if (month == 11 || month == 2) {
			total += tires_cost;      // tires change
		}
		if (month == 6) {
			total += TI_cost;         // technical inspection
		}
		if (month == 9) {
			total += insurance_cost;  // insurance - страховка
		}
		if (month % 2 == 0) {
			total += wash_cost;       // wash once per 2 month
		}
		if (alice.cash <= total) {
			alice.car = false;
		}
		else if (alice.cash > total) {
			alice.cash -= total;
			alice.car_spend += total;
			alice.car = true;
			printf("car %d\n");
		}
	}
	if (alice.cash > Metro and alice.car == false) { // no car - metro
		alice.cash -= Metro;
		printf("metro");
	}
	else if (alice.cash < Metro and alice.car == false) { //no car n metro - walk
		alice.mood -= 0.1;
		printf("walk");
	}
	
}
void alice_dog(const int year, const int month) {

	const RUB dogfood_cost = 15'000;
	const RUB dog_cost = 30'000;
	const RUB toys_cost = 3'000;

	if (alice.mood < 0.5 and alice.cash > 50'000 and alice.dog == false) {
		alice.dog = true;
		alice.cash -= dog_cost;
	}
	if (alice.dog == true) {
		alice.cash -= dogfood_cost;
		alice.cash -= toys_cost;
		alice.mood += 0.02;
	}

}
void alice_food(const int year, const int month) {
	const RUB food_cost = 20'000; 
	const RUB coffee_cost = 3'000; 
	const RUB restaurant_cost = 5'000;  
	const RUB delivery_cost = 2'000;  

	RUB total = 0;
	alice.cash -= food_cost;
	total += food_cost;

	if (alice.cash >= coffee_cost) { //morning coffe
		alice.cash -= coffee_cost;
		total += coffee_cost;
	}
	if (alice.cash >= restaurant_cost) {
		alice.cash -= restaurant_cost; // restaurant once a month
		total += restaurant_cost;
	}
	if (month % 2 == 0 and alice.cash >= delivery_cost) {
		alice.cash -= delivery_cost; // delivery
		total += delivery_cost;
	}
	alice.food += total;
	total = 0;

}

