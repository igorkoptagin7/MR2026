bool job_interview(const Person& person)//собеседование
{
    int chance = 50;

    chance += person.education / 5;

    if (person.work_experience > 0)
    {
        chance += 10;
    }

    int result = rand() % 100;

    return result < chance;
}


void find_job(Person& person)//есть ли работа
{
    if (person.has_job)
    {
        return;
    }

    if (job_interview(person))
    {
        person.has_job = true;
        person.salary = 80'000;
    }
}


void salary(const int year, const int month)//зарплата
{
    find_job(alice);
    find_job(bob);

    if (alice.has_job)
    {
        alice.cash += alice.salary;
    }

    if (bob.has_job)
    {
        bob.cash += bob.salary;
    }
}


void update_work_experience()//опыт работы
{
    if (alice.has_job)
    {
        ++alice.work_experience;
    }

    if (bob.has_job)
    {
        ++bob.work_experience;
    }
}


void deposit_for_person(Person& person)//накопление
{
    RUB deposit_amount = person.salary / 10;

    if (deposit_amount > person.cash)
    {
        deposit_amount = person.cash;
    }

    person.cash -= deposit_amount;
    person.savings += deposit_amount;

    if (person.strategy == fixed_deposit)
    {
        // Фиксированный доход 1% в месяц
        RUB income = person.savings / 100;
        person.savings += income;
    }

    if (person.strategy == stocks)
    {
        // Доход от акций от -1% до +2%
        int stock_change = rand() % 4 - 1;

        RUB income = person.savings * stock_change / 100;
        person.savings += income;

        if (person.savings < 0)
        {
            person.savings = 0;
        }
    }
}


void deposit()//вклад или акции
{
    deposit_for_person(alice);
    deposit_for_person(bob);
}


