void simulation()//симуляция
{
    int year = 2026;
    int month = 9;

    while (not (year == 2036 and month == 9))
    {
        inflation();

        salary(year, month);
        deposit();

        housing();
        food();

        health();

        entertainment();
        education();

        dating();
        family_update();

        financial_check();
        happiness_check();

        if (month == 12 or month == 3 or month == 6 or month == 9)
        {
            update_work_experience();
        }

        ++month;

        if (month == 13)
        {
            ++year;
            month = 1;
        }
    }
}


