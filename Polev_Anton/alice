#include <iostream>
#include <cstdio>
using namespace std;

using RUB = int;

struct Person {
    RUB cash;
    RUB salary;
};

Person alice;

void simulation()
{
    int year = 2026;
    int month = 9;

    while (!(year == 2027 && month == 9))
    {
        alice.cash += alice.salary;

        cout << "Year: " << year << ", Month: " << month << endl;

        month++;

        if (month > 12)
        {
            month = 1;
            year++;
        }
    }
}

void alice_init()
{
    alice.cash = 20'000;
    alice.salary = 80'000;
}

void alice_print()
{
    printf("Alice cash = %d\n", alice.cash);
}

int main()
{
    alice_init();
    simulation();
    alice_print();

    return 0;
}
